{
    "name": "@repo/domain",
    "version": "0.0.0",
    "private": true,
    "//": "BROWSER-BUNDLABLE CONSTRAINT: this package is imported by the Next.js client. Its runtime dependencies MUST contain ONLY @repo/types. No pg, fs, path, node:*, or any Node-only import — ever. Enforce at every PR.",
    "main": "./dist/index.js",
    "types": "./src/index.ts",
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "default": "./dist/index.js"
        }
    },
    "files": ["dist"],
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "check-types": "tsc --noEmit"
    },
    "dependencies": {
        "@repo/types": "workspace:*"
    },
    "devDependencies": {
        "@repo/typescript-config": "workspace:*",
        "typescript": "^5.9.3"
    }
}

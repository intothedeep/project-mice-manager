{
    "name": "project-lopez-auto",
    "private": true,
    "packageManager": "pnpm@9.15.9",
    "scripts": {
        "build": "turbo run build",
        "dev": "turbo run dev",
        "dev:web": "pnpm --filter colony_client_web dev",
        "dev:server": "pnpm --filter colony_server dev",
        "lint": "turbo run lint",
        "check-types": "turbo run check-types",
        "test": "turbo run test",
        "format": "prettier --write \"**/*.{ts,tsx,md}\""
    },
    "devDependencies": {
        "eslint": "^9.39.4",
        "prettier": "^3.8.4",
        "turbo": "^2.10.0",
        "typescript": "^5.9.3"
    },
    "engines": {
        "node": ">=24"
    }
}
